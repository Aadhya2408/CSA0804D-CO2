UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
DIGITS = '0123456789'

def normalise(text):
    # strings are immutable: every method returns a NEW string
    text = text.strip().upper()       # must re-bind: text.upper() alone changes nothing
    text = text.replace(' ', '').replace('-', '')
    return text

def all_in(s, allowed):
    for ch in s:
        if ch not in allowed:
            return False
    return True

def is_valid(plate):
    s = normalise(plate)
    if len(s) not in (9, 10):
        return False
    state = s[:2]       # TN
    district = s[2:4]   # 09
    series = s[4:-4]    # AB (1 or 2 letters)
    number = s[-4:]     # 1234
    return (all_in(state, UPPER) and all_in(district, DIGITS)
            and 1 <= len(series) <= 2 and all_in(series, UPPER)
            and all_in(number, DIGITS))

tests = ['TN 09 AB 1234', 'tn-09-a-1234', 'TN09AB123', 'T9 09 AB 1234', 'TN 09 ABC 1234', 'KA01MM0007']
for t in tests:
    print(f'{t!r:20} -> {normalise(t)!r:14} -> {is_valid(t)}')
